GOOGLE_VISION_API_KEY="GoogleVisionAPIのAPIキー"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER="ユーザー名"
DB_PASSWORD="パスワード"
DB_NAME="データベース"

MYSQL_ROOT_PASSWORD="ルート用のパスワード"
MYSQL_DATABASE="上記と同じデータベース"
MYSQL_USER="上記と同じユーザー"
MYSQL_PASSWORD="上記と同じパスワード"


# Gemini APIキー
GEMINI_API_KEY=ここにGeminiのAPIキー

# 無料枠で高頻度利用しやすい軽量モデル
GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini確認を有効化
GEMINI_REVIEW_ENABLED=true

# 無料枠切れでも問題生成全体は止めない
GEMINI_REVIEW_REQUIRED=false

# Geminiへ送る資料本文の最大文字数
GEMINI_REVIEW_MAX_SOURCE_LENGTH=2500

# Geminiの最大出力トークン
GEMINI_REVIEW_MAX_OUTPUT_TOKENS=2500

# Geminiリクエスト間隔
GEMINI_REVIEW_MIN_INTERVAL_MS=5000

# 429・503などの最大再試行回数
GEMINI_REVIEW_MAX_RETRIES=3

# Gemini確認結果のキャッシュ時間
GEMINI_REVIEW_CACHE_TTL_MS=21600000

# タイムアウト
GEMINI_REVIEW_TIMEOUT_MS=180000

GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta